{
  "name": "datacanvas-monorepo",
  "version": "1.0.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShubhamTiwari909/pg-visualizer.git"
  },
  "homepage": "https://github.com/ShubhamTiwari909/pg-visualizer#readme",
  "bugs": {
    "url": "https://github.com/ShubhamTiwari909/pg-visualizer/issues"
  },
  "private": true,
  "description": "DataCanvas: a local-first visual PostgreSQL explorer (monorepo root, not published).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsc -b && npm run dev -w apps/web",
    "build": "tsc -b && npm run build -w apps/web",
    "build:packages": "tsc -b",
    "typecheck": "tsc -b && npm run typecheck -w apps/web && tsc -p e2e",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/build-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:e2e": "npx playwright test",
    "screenshots": "SCREENSHOTS=1 npx playwright test e2e/screenshots.spec.ts",
    "release:check": "node scripts/release-check.mjs",
    "notices": "node scripts/generate-notices.mjs && prettier --write THIRD-PARTY-NOTICES.md",
    "test:pg-matrix": "node scripts/pg-matrix.mjs",
    "start": "node .package/bin/datacanvas.mjs",
    "app": "npm run package && npm run start --",
    "publish:npm": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
