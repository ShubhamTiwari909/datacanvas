{
  "name": "datacanvas-monorepo",
  "version": "1.12.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShubhamTiwari909/datacanvas.git"
  },
  "homepage": "https://github.com/ShubhamTiwari909/datacanvas#readme",
  "bugs": {
    "url": "https://github.com/ShubhamTiwari909/datacanvas/issues"
  },
  "private": true,
  "description": "DataCanvas: a local-first visual PostgreSQL explorer (monorepo root, not published).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "tsc -b && pnpm --filter @datacanvas/web run dev",
    "build": "tsc -b && pnpm --filter @datacanvas/web run build",
    "build:packages": "tsc -b",
    "typecheck": "tsc -b && pnpm --filter @datacanvas/web run typecheck && tsc -p e2e",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "package": "pnpm run build && node scripts/build-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:e2e": "pnpm exec playwright test",
    "screenshots": "SCREENSHOTS=1 pnpm exec playwright test e2e/screenshots.spec.ts",
    "release:check": "node scripts/release-check.mjs",
    "notices": "node scripts/generate-notices.mjs && prettier --write THIRD-PARTY-NOTICES.md",
    "test:pg-matrix": "node scripts/pg-matrix.mjs",
    "start": "node .package/bin/datacanvas.mjs",
    "app": "pnpm run package && pnpm run start --",
    "publish:npm": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@datacanvas/postgres-adapter": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "axe-core": "4.14.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
